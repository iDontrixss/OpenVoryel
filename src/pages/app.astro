---
import Layout from "../layouts/Layout.astro"
import App from "../components/App"
---

<Layout title="App" description="Conecta tu key Zen, elige modelo Contributor y chatea desde la web.">
  <section class="ov-app">
    <div>
      <h1>App</h1>
      <p class="ov-muted">
        Misma secuencia que la app desktop: conectar Zen, elegir modelo, chatear.
        La key solo vive en tu navegador (localStorage); cada request va a nuestro
        <code>/api/zen</code>, que la reenvia a <code>opencode.ai/zen/v1</code> sin
        guardarla en el servidor.
      </p>
    </div>
    <App client:load />
  </section>
</Layout>
