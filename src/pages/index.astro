---
import Layout from "../layouts/Layout.astro"

// Copy copiado de packages/web/src/content/i18n/en.json (app.lander.*)
// + linea Zen de packages/app/src/i18n/en.ts (provider.connect.opencodeZen).
---

<Layout title="The AI coding agent built for the terminal">
  <section class="ov-hero">
    <h1>The AI coding agent built for the terminal.</h1>
    <p>
      OpenVoryel web: la misma integracion Zen que la app —modelos curados y la ventaja
      Contributor— adaptada al navegador. Sin Electron, sin sidecar local: tu key Zen en
      localStorage y un proxy server-side en <code>/api/zen</code>.
    </p>
    <div class="ov-cta">
      <a class="ov-btn primary" href="/app">Get Started</a>
      <a class="ov-btn" href="https://opencode.ai/zen" target="_blank" rel="noreferrer">opencode.ai/zen</a>
    </div>
    <div class="ov-command">
      <code>curl -fsSL https://opencode.ai/install | bash</code>
    </div>
  </section>

  <section class="ov-features">
    <ul>
      <li><b>Native TUI</b>: A responsive, native, themeable terminal UI.</li>
      <li><b>LSP enabled</b>: Automatically loads the right LSPs for the LLM.</li>
      <li><b>Multi-session</b>: Start multiple agents in parallel on the same project.</li>
      <li><b>Shareable links</b>: Share a link to any sessions for reference or to debug.</li>
      <li><b>Use any model</b>: Supports 75+ LLM providers, including local models.</li>
      <li>
        <span class="ov-badge">Contributor</span>
        <b> Zen en la web</b>: <code>muse-spark-1.3-contributor-free</code>,
        <code>mimo-v2.5-free</code>, <code>ling-3.0-flash-fin-free</code>,
        <code>nemotron-3-ultra-free</code> y <code>nemotron-3.5-lightning-free</code> —
        pega tu key en <a href="/app">/app</a> y listo.
      </li>
    </ul>
    <div class="ov-cta">
      <div class="ov-command"><code>npm install -g opencode-ai</code></div>
      <div class="ov-command"><code>bun install -g opencode-ai</code></div>
    </div>
  </section>
</Layout>
