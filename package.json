{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "openvoryel-web",
  "description": "OpenVoryel web — misma integracion Zen que la app, adaptada a web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "typecheck": "astro check",
    "cf:deploy": "bun run build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.3",
    "@astrojs/solid-js": "5.1.0",
    "astro": "5.7.13",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/node": "24.12.2",
    "typescript": "5.8.2",
    "wrangler": "4.30.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
